<?xml version='1.0' encoding='utf-8'?>
<widget android-packageName="com.useinsider.ecommerce" id="com.useinsider.demo.external" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <feature name="CDVWebViewEngine">
        <param name="ios-package" value="CDVWebViewEngine" />
    </feature>
    <feature name="LaunchScreen">
        <param name="ios-package" value="CDVLaunchScreen" />
    </feature>
    <feature name="LocalStorage">
        <param name="ios-package" value="CDVLocalStorage" />
    </feature>
    <feature name="Console">
        <param name="ios-package" value="CDVLogger" />
        <param name="onload" value="true" />
    </feature>
    <feature name="HandleOpenUrl">
        <param name="ios-package" value="CDVHandleOpenURL" />
        <param name="onload" value="true" />
    </feature>
    <feature name="IntentAndNavigationFilter">
        <param name="ios-package" value="CDVIntentAndNavigationFilter" />
        <param name="onload" value="true" />
    </feature>
    <feature name="GestureHandler">
        <param name="ios-package" value="CDVGestureHandler" />
        <param name="onload" value="true" />
    </feature>
    <feature name="StatusBarInternal">
        <param name="ios-package" value="CDVStatusBarInternal" />
        <param name="onload" value="true" />
    </feature>
    <feature name="InsiderPlugin">
        <param name="ios-package" value="InsiderPlugin" />
    </feature>
    <feature name="FirebaseMessaging">
        <param name="ios-package" value="FirebaseMessagingPlugin" />
        <param name="onload" value="true" />
    </feature>
    <name>CordovaDemo</name>
    <description>This Demo contains simple methods that you can use with the Insider SDK.</description>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <hook src="scripts/ios-extension-check.js" type="after_prepare" />
    <icon foreground="res/icons/ios/icon-dark.png" monochrome="res/icons/ios/icon-tinted.png" src="res/icons/ios/icon.png" />
    <config-file parent="com.apple.security.application-groups" target="*/Entitlements-Debug.plist">
        <array>
            <string>group.com.useinsider.mobile-ios</string>
        </array>
    </config-file>
    <config-file parent="com.apple.security.application-groups" target="*/Entitlements-Release.plist">
        <array>
            <string>group.com.useinsider.mobile-ios</string>
        </array>
    </config-file>
    <config-file parent="CFBundleURLTypes" target="*-Info.plist">
        <array>
            <dict>
                <key>CFBundleURLName</key>
                <string>insider</string>
                <key>CFBundleURLSchemes</key>
                <array>
                    <string>insideryourpartnername</string>
                </array>
            </dict>
        </array>
    </config-file>
    <preference name="AllowInlineMediaPlayback" value="false" />
    <preference name="DisallowOverscroll" value="false" />
    <preference name="EnableViewportScale" value="false" />
    <preference name="MediaPermissionGrantType" value="grantIfSameHostElsePrompt" />
    <preference name="MediaTypesRequiringUserActionForPlayback" value="none" />
    <preference name="SuppressesIncrementalRendering" value="false" />
    <preference name="SuppressesLongPressGesture" value="false" />
    <preference name="Suppresses3DTouchGesture" value="false" />
    <preference name="deployment-target" value="15.0" />
</widget>
