{
  "name": "com.useinsider.cordovademo",
  "displayName": "CordovaDemo",
  "version": "1.0.0",
  "description": "A sample Apache Cordova application that responds to the deviceready event.",
  "main": "index.js",
  "scripts": {
    "test": "jest --ci"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Insider",
  "license": "MIT",
  "devDependencies": {
    "cordova-android": "^15.1.0",
    "cordova-ios": "^8.2.0",
    "cordova-plugin-insider": "^4.2.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/test"
    ],
    "transform": {}
  },
  "cordova": {
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": {
      "cordova-plugin-insider": {},
      "cordova-plugin-firebase-messaging": {
        "ANDROID_FIREBASE_BOM_VERSION": "34.19.0",
        "IOS_FIREBASE_SDK_VERSION": "12.19.1"
      }
    }
  },
  "dependencies": {
    "cordova-plugin-firebase-messaging": "9.2.0",
    "cordova-support-android-plugin": "2.0.4"
  }
}